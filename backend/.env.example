# PostgreSQL instalado y ejecutándose en ESTA computadora.
# Copiar este archivo como .env dentro de backend; cada integrante usa sus credenciales.
# Crear prestamos_db en pgAdmin con el mismo propietario que DB_USERNAME.
# Ajustar el puerto si la instalación local no usa 5432.
DB_URL=jdbc:postgresql://localhost:5432/prestamos_db
DB_USERNAME=postgres
DB_PASSWORD=cambia_esta_contrasena
# Usar un secreto aleatorio propio de al menos 32 caracteres.
JWT_SECRET=reemplaza_por_una_clave_aleatoria_de_al_menos_32_caracteres
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:5173
ADMIN_PASSWORD=Admin123*
USER_PASSWORD=Usuario123*
